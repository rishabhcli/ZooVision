# Core
# Production requires fixture mode off plus configured TwelveLabs, OpenAI,
# Neo4j write credentials, and enabled S3 archival.
ZOOVISION_ENV=development
ZOOVISION_FIXTURE_MODE=true
ZOOVISION_TIMEZONE=America/Los_Angeles
ZOOVISION_NIGHT_START=19:00
ZOOVISION_NIGHT_END=06:00

# Fast local object localization. YOLO classes are candidates for human review;
# they never assign behavior, severity, diagnosis, or animal identity.
ZOOVISION_YOLO_ENABLED=true
ZOOVISION_YOLO_MODEL=yolov8n.pt
ZOOVISION_YOLO_DEVICE=auto
ZOOVISION_YOLO_SAMPLE_FPS=2
ZOOVISION_YOLO_CONFIDENCE=0.05
ZOOVISION_YOLO_IMAGE_SIZE=640
ZOOVISION_YOLO_BATCH_SIZE=16

# OpenAI
OPENAI_API_KEY=
ZOOVISION_OPENAI_ENRICHMENT_ENABLED=false
OPENAI_MERGE_MODEL=gpt-5.6-luna
OPENAI_REPORT_MODEL=gpt-5.6-terra

# Optional live providers
TWELVELABS_API_KEY=
TWELVELABS_MODEL=pegasus1.5

# AWS uses a dedicated least-privilege local identity. Prefer an attached role
# instead of long-lived keys when the application runs on AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
# Optional local-only profile when Bedrock lives in a separate workshop account.
AWS_BEDROCK_PROFILE=
# Explicit temporary Bedrock credentials take precedence over the profile.
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=
AWS_BEDROCK_SESSION_TOKEN=
ZOOVISION_AWS_STORAGE_ENABLED=false
ZOOVISION_S3_RAW_BUCKET=
ZOOVISION_S3_ANALYSIS_BUCKET=
ZOOVISION_S3_CLIPS_BUCKET=
ZOOVISION_BEDROCK_MARENGO_MODEL=twelvelabs.marengo-embed-3-0-v1:0

NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_READ_USERNAME=
NEO4J_READ_PASSWORD=

# Local/deployed Sites UI proxy target. The local default is http://127.0.0.1:8000.
ZOOVISION_API_ORIGIN=http://127.0.0.1:8000
# Hosted edge login. Keep disabled for local development. Store the password and
# proxy secret as managed deployment secrets, never in source control.
ZOOVISION_EDGE_AUTH_ENABLED=false
ZOOVISION_EDGE_AUTH_USERNAME=
ZOOVISION_EDGE_AUTH_PASSWORD=
ZOOVISION_PROXY_SHARED_SECRET=
SLACK_WEBHOOK_URL=
ZOOVISION_ALERT_DELIVERY_ENABLED=false

# Storage and alert policy
ZOOVISION_STORAGE_ROOT=./data
ZOOVISION_RAW_RETENTION_DAYS=7
ZOOVISION_ANALYSIS_RETENTION_DAYS=30
ZOOVISION_CLIP_RETENTION_DAYS=90
ZOOVISION_ALERT_ACK_MINUTES=20
