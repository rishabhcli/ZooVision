# Core
ZOOVISION_ENV=development
ZOOVISION_FIXTURE_MODE=true
ZOOVISION_TIMEZONE=America/Los_Angeles
ZOOVISION_NIGHT_START=19:00
ZOOVISION_NIGHT_END=06:00

# OpenAI
OPENAI_API_KEY=
ZOOVISION_OPENAI_ENRICHMENT_ENABLED=false
OPENAI_MERGE_MODEL=gpt-5.6-luna
OPENAI_REPORT_MODEL=gpt-5.6-terra

# Optional live providers
TWELVELABS_API_KEY=
TWELVELABS_MODEL=pegasus1.5

# AWS uses a dedicated least-privilege local identity. Prefer an attached role
# instead of long-lived keys when the application runs on AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
# Optional local-only profile when Bedrock lives in a separate workshop account.
AWS_BEDROCK_PROFILE=
# Explicit temporary Bedrock credentials take precedence over the profile.
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=
AWS_BEDROCK_SESSION_TOKEN=
ZOOVISION_AWS_STORAGE_ENABLED=false
ZOOVISION_S3_RAW_BUCKET=
ZOOVISION_S3_ANALYSIS_BUCKET=
ZOOVISION_S3_CLIPS_BUCKET=
ZOOVISION_BEDROCK_MARENGO_MODEL=twelvelabs.marengo-embed-3-0-v1:0

NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_READ_USERNAME=
NEO4J_READ_PASSWORD=
SLACK_WEBHOOK_URL=
ZOOVISION_ALERT_DELIVERY_ENABLED=false

# Storage and alert policy
ZOOVISION_STORAGE_ROOT=./data
ZOOVISION_RAW_RETENTION_DAYS=7
ZOOVISION_ANALYSIS_RETENTION_DAYS=30
ZOOVISION_CLIP_RETENTION_DAYS=90
ZOOVISION_ALERT_ACK_MINUTES=20
